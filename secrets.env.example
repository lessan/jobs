# Copy to ~/.config/dev-jobs/secrets.env and chmod 600.
# Claude, Codex, Grok, and Antigravity normally use their own CLI login.

# z.ai Anthropic-compatible gateway (`glm` engine)
GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/anthropic

# Operator-controlled Anthropic-compatible gateway (`local` engine)
LOCAL_API_KEY=
LOCAL_BASE_URL=http://127.0.0.1:8080
